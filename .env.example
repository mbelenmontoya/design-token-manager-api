# .env.example

# Server
PORT=4000

# MongoDB Atlas connection string
# Replace <username>, <password>, <cluster> and <dbname>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT settings
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h

# Front-end URL (for CORS)
CLIENT_URL=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# DAL Configuration (Database Abstraction Layer)
# Options: mongo | supabase | dual
DB_READS=
DB_WRITES=

API_KEY=
TENANT_ID=
PROJECT_ID=

# Webhook Configuration
# Mercado Pago webhook secret for signature validation
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here
# Set to 'true' to enforce signature validation (recommended for production)
MERCADOPAGO_ENFORCE_SIGNATURE=false

# Email Configuration
# Email provider: console (dev), sendgrid, resend
EMAIL_PROVIDER=console
# Default "from" email address
EMAIL_FROM=noreply@yourdomain.com
# SendGrid API key (if using SendGrid)
SENDGRID_API_KEY=
# Resend API key (if using Resend)
RESEND_API_KEY=

# Billing Configuration
# Billing provider: stripe, mercadopago
BILLING_PROVIDER=stripe
# Return URL after billing portal session
BILLING_PORTAL_RETURN_URL=http://localhost:5173/settings/billing

