{
  "type": "module",
  "name": "design-token-manager-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint \"src/**/*.js\"",
    "postinstall": "npx prisma generate",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:endpoints": "node --experimental-vm-modules node_modules/.bin/jest --config tests/jest.config.js --runInBand",
    "test:dal": "npm test -- tests/dal/",
    "test:quick": "./scripts/quick-test.sh",
    "test:comprehensive": "./scripts/comprehensive-test.sh",
    "test:performance": "./scripts/performance-test.sh",
    "migration:status": "curl -s http://localhost:4000/status/database | jq .",
    "health:check": "curl -s http://localhost:4000/health | jq .",
    "prisma:generate": "npx prisma generate",
    "prisma:validate": "npx prisma validate && npx prisma format --check",
    "prisma:studio": "npx prisma studio",
    "bootstrap:supabase": "node scripts/bootstrapSupabase.js",
    "smoke:supabase": "node scripts/smokeSupabase.js",
    "smoke:status": "node scripts/checkStatus.js",
    "smoke:memberships": "node scripts/smokeMemberships.js",
    "smoke:api-keys": "node scripts/smokeApiKeysList.js",
    "smoke:billing": "node scripts/smokeBilling.js",
    "smoke:all": "node scripts/smokeAll.js",
    "test:supabase": "node --experimental-vm-modules node_modules/.bin/jest --config tests/supabase/jest.supabase.config.js --runInBand",
    "local:verify": "./scripts/local-verify.sh"
  },
  "jest": {
    "testEnvironment": "node"
  },
